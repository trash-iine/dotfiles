{
  "model": "opus",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Edit(~/.password-store/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/Library/Keychains/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/credentials.json)",
      "Read(//**/service-account*.json)",
      "Bash(pass)",
      "Bash(pass *)",
      "Bash(pass:*)",
      "Bash(gopass *)",
      "Bash(gopass:*)",
      "Bash(gpg --decrypt *)",
      "Bash(gpg -d *)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Bash(gh auth token)",
      "Bash(gh auth token *)",
      "Bash(op *)",
      "Bash(op:*)",
      "Bash(aws configure get *)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(printenv:*)"
    ]
  }
}
