# bootstrap.sh links ~/.config/git to this directory, so `git config --global`
# writes straight back into the repository. It also moves an existing
# ~/.gitconfig aside, because git reads that file last and it would otherwise
# override everything set here.

[user]
	name = Trash-iine
	email = 50480656+trash-iine@users.noreply.github.com

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.config/git/ignore
	pager = delta
	# WSL2 shares repositories with Windows tools that write CRLF. Normalising
	# on commit keeps the history LF-only without touching the working tree.
	autocrlf = input

[pull]
	rebase = true

[rebase]
	autoStash = true
	autosquash = true

[push]
	autoSetupRemote = true
	default = simple

[fetch]
	prune = true

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictStyle = zdiff3

[branch]
	sort = -committerdate

[column]
	ui = auto

[rerere]
	enabled = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Nord

[alias]
	st = status --short --branch
	co = checkout
	sw = switch
	br = branch
	last = log -1 HEAD --stat
	amend = commit --amend --no-edit
	# Drop the last commit but keep its changes staged.
	undo = reset --soft HEAD~1
	lg = log --graph --abbrev-commit --date=relative \
		--format=format:'%C(bold blue)%h%C(reset) %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'

# Machine-specific overrides -- a work email, a different signing key. Ignored
# by the repository, and git does not mind if the file is absent.
[include]
	path = config.local
